# Copie para backend/.env e preencha. O .env nunca vai para o Git nem para o navegador.

# Notícias — https://gnews.io (Capa)
GNEWS_API_KEY=

# Palavras-cruzadas — https://crossword.texs.org/crossword-api (Página 2)
CROSSWORD_API_KEY=

# IA — escolhemos juntas o provedor e o modelo
AI_API_KEY=
AI_MODEL=

# Fuso editorial (a "data de hoje" da edição)
TZ_EDITORIAL=America/Fortaleza
