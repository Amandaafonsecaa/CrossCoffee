# Copie para gerador/.env. Este arquivo nunca vai para o Git nem para o navegador.

# IA local (Ollama) — sem chave, sem custo
OLLAMA_URL=http://localhost:11434
MODELO_TEXTO=
MODELO_EMBEDDINGS=

# Chave que cifra o estoque de edições futuras.
# A mesma chave fica nos "secrets" do GitHub e num gerenciador de senhas.
CHAVE_ESTOQUE=

# Fuso editorial
TZ_EDITORIAL=America/Fortaleza
